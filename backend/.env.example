# backend/.env.example
# Copie este arquivo para backend/.env e preencha com os seus valores.

# --- Banco de dados PostgreSQL ---
# Em desenvolvimento local: localhost
# Com docker-compose: banco_de_dados (nome do serviço)
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=petcare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# Alternativa usada por provedores de hospedagem (Render, Railway, Heroku...).
# Se preenchida, tem prioridade sobre as variáveis acima.
# DATABASE_URL=postgresql://usuario:senha@host:5432/petcare

# --- Endereços da aplicação ---
# Endereço público do frontend (usado nos links enviados por e-mail).
FRONTEND_URL=http://localhost:5173
# Origens autorizadas a chamar a API, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
# Porta em que a API escuta (definida automaticamente por alguns provedores).
PORT=5000
# Em produção deixe como false.
FLASK_DEBUG=true

# --- pgAdmin (apenas docker-compose) ---
PGADMIN_DEFAULT_EMAIL=admin@petcare.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- Envio de e-mail ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app
MAIL_DEFAULT_SENDER=seu-email@gmail.com

# --- Login com o Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIRECT_URI=http://localhost:5173
