# .env.example (raiz)
# Variáveis lidas pelo docker-compose. Copie para .env e ajuste se necessário.

# Endereço da API embutido no build do frontend.
VITE_API_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=

# Endereço público do frontend, usado pela API nos links de e-mail e no CORS.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
